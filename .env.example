# 이 파일을 .env.local 로 복사해서 채운다.

# 로컬은 docker compose 의 PostGIS, 배포는 Supabase 연결 문자열
DATABASE_URL=postgres://jario:jario_local_dev@localhost:54329/jario

# 카카오맵 JavaScript 키 (https://developers.kakao.com)
#
# 브라우저에 노출되는 키다. 숨길 수 없으므로 도메인 제한이 유일한 방어다.
#
# 등록 위치: [앱 → 플랫폼 키 → JavaScript 키 → JavaScript SDK 도메인]
#   · [제품 링크 관리 → 웹 도메인]은 카카오 로그인·공유용이라 지도에는 효과가 없다.
#     예전 UI의 '플랫폼 → Web → 사이트 도메인'을 안내하는 글이 많은데 그건 이쪽이다.
#   · 지도 API는 [앱 관리 → 카카오맵 → 사용 설정]이 ON이어야 동작한다.
#
# 개발 서버 포트를 3001로 고정해뒀으니 http://localhost:3001 을 등록한다.
NEXT_PUBLIC_KAKAO_MAP_KEY=
